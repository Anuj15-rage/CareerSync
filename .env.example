# =============================================================================
# CareerSync Deployment Environment Variables Template (.env.example)
#
# IMPORTANT:
# - Copy this file to .env on your deployment host.
# - DO NOT point these settings to the local development database (careersync_db).
# - Provision a separate remote MySQL database for deployment (e.g. careersync_prod_db).
# =============================================================================

# Deployment MySQL Database Configuration
DB_HOST=your-remote-mysql-host.com
DB_PORT=3306
DB_USER=careersync_prod_user
DB_PASSWORD=your_secure_database_password
DB_NAME=careersync_prod_db
# Set DB_SSL=true for cloud MySQL providers requiring TLS/SSL (e.g., TiDB Cloud, Aiven)
DB_SSL=false
# Optional custom CA path if required by the cloud host (omit or leave commented for system CAs)
# DB_SSL_CA=/path/to/ca.pem

# CORS Allowed Origins (Comma-separated)
# In unified hosting, frontend and API share origin. Include external origins if needed.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Security & Proxy Trust
# Comma-separated list of trusted reverse proxy IPs. Only connections from these socket
# IPs will have forwarded client-IP headers (X-Forwarded-For, X-Real-IP) trusted.
TRUSTED_PROXIES=127.0.0.1,::1

# Upload Rate Limiting
# Maximum number of uploads permitted per window per verified client IP
RATE_LIMIT_UPLOADS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Request Layer Size Ceiling (7 MB total request body)
MAX_REQUEST_SIZE_BYTES=7340032

# Lifecycle & Retention Management
# Resumes older than RESUME_EXPIRATION_HOURS are automatically deleted
RESUME_EXPIRATION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
